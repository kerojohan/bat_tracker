background:
  sample_frames: 200
  uniform_sampling: true

detection:
  blur_kernel: 5
  threshold_mode: otsu
  diff_threshold: 18
  otsu_offset: -4
  morph_open: 1
  morph_close: 3
  min_area: 6
  max_area: 5000

tracking:
  max_distance: 60.0
  max_missed: 12
  min_track_length: 1

output:
  overlay_line_thickness: 2
  overlay_start_radius: 5
  overlay_alpha: 1.0
